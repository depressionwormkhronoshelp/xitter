rules_version = '2';
// Правила безопасности Firestore для Xitter.
service cloud.firestore {
  match /databases/{database}/documents {
    function signedIn() { return request.auth != null; }
    function uid() { return request.auth.uid; }
    function isMember(chatId) {
      return uid() in get(/databases/$(database)/documents/chats/$(chatId)).data.members;
    }

    // Владелец приложения: вход через Google с этим адресом (адрес подтверждён Google)
    function isOwner() {
      return signedIn() && request.auth.token.email == 'cladecarvsna@gmail.com'
        && request.auth.token.email_verified == true;
    }
    function isAdmin() {
      return isOwner() || (signedIn() && exists(/databases/$(database)/documents/admins/$(uid())));
    }

    // Статус: баланс LUNE, Plus, галочка, бан и ограничение. Меняет только админ.
    function statusPath(u) { return /databases/$(database)/documents/status/$(u); }
    function st(u) { return exists(statusPath(u)) ? get(statusPath(u)).data : {}; }
    function isPlus(u) { return st(u).get('plusUntil', 0) > request.time.toMillis(); }
    function isBanned() { return st(uid()).get('banned', false) == true; }
    // забаненные и ограниченные не могут писать посты, комментарии и сообщения
    function canWrite() {
      return signedIn() && !isBanned() && st(uid()).get('restricted', false) != true;
    }

    // Профили видны всем вошедшим, менять можно только свой.
    // Оформление (style: баннер, эмодзи, обводка, шрифт, аватар-видео) — только с Plus.
    match /users/{userId} {
      allow read: if signedIn();
      allow create: if signedIn() && uid() == userId && !('style' in request.resource.data);
      allow update: if signedIn() && uid() == userId && !isBanned()
        && (!request.resource.data.diff(resource.data).affectedKeys().hasAny(['style'])
          || isPlus(uid()) || request.resource.data.get('style', null) == null);
      // удаление аккаунта
      allow delete: if signedIn() && uid() == userId;
    }

    match /status/{userId} {
      allow read: if signedIn();
      allow create, update: if isAdmin() || buysUsername(userId) || spends(userId) || getsSalePayment(userId) || sellsGift(userId);
      allow delete: if isAdmin() || (signedIn() && uid() == userId);
    }

    // ---------- траты LUNE: подарок, выпуск NFT, покупка NFT с рук ----------
    // В той же операции в status пишется spend = { k, id } — что именно куплено
    function spends(userId) {
      let before = resource.data;
      let after = request.resource.data;
      let price = spendPrice(after.spend);
      return signedIn() && uid() == userId && !isBanned()
        && after.diff(before).affectedKeys().hasOnly(['lune', 'spend'])
        && price > 0 && before.get('lune', 0) >= price
        && after.lune == before.get('lune', 0) - price;
    }
    function spendPrice(sp) {
      return sp.k == 'gift' ? giftCost(sp.id) : sp.k == 'mint' ? mintCost(sp.id) : sp.k == 'buy' ? buyCost(sp.id) : -1;
    }
    function giftCost(id) {
      let g = getAfter(/databases/$(database)/documents/gifts/$(id)).data;
      return !exists(/databases/$(database)/documents/gifts/$(id)) && g.from == uid() ? g.price : -1;
    }
    function mintCost(nid) {
      let n = getAfter(/databases/$(database)/documents/nfts/$(nid)).data;
      return !exists(/databases/$(database)/documents/nfts/$(nid)) && n.owner == uid()
        ? get(/databases/$(database)/documents/nftCollections/$(n.cid)).data.price : -1;
    }
    function buyCost(nid) {
      let n = get(/databases/$(database)/documents/nfts/$(nid)).data;
      return n.owner != uid() && n.get('salePrice', 0) > 0
        && getAfter(/databases/$(database)/documents/nfts/$(nid)).data.owner == uid() ? n.salePrice : -1;
    }
    // Продавец NFT получает LUNE от покупателя в той же операции
    function getsSalePayment(userId) {
      let before = resource == null ? {} : resource.data;
      let after = request.resource.data;
      let n = get(/databases/$(database)/documents/nfts/$(after.sale)).data;
      return signedIn() && uid() != userId
        && after.diff(before).affectedKeys().hasOnly(['lune', 'sale'])
        && n.owner == userId && n.get('salePrice', 0) > 0
        && getAfter(/databases/$(database)/documents/nfts/$(after.sale)).data.owner == uid()
        && after.lune == before.get('lune', 0) + n.salePrice;
    }

    // Продажа обычного подарка: получатель удаляет его и получает 85% цены
    function sellsGift(userId) {
      let before = resource == null ? {} : resource.data;
      let after = request.resource.data;
      let gpath = /databases/$(database)/documents/gifts/$(after.sold);
      return signedIn() && uid() == userId && !isBanned()
        && after.diff(before).affectedKeys().hasOnly(['lune', 'sold'])
        && exists(gpath) && !existsAfter(gpath)
        && get(gpath).data.to == uid()
        && after.lune == before.get('lune', 0) + giftSellValue(get(gpath).data.price);
    }
    function giftSellValue(price) { return int(price * 85 / 100); }

    // Обычные подарки: цена в LUNE фиксирована, можно подарить сразу несколько (count)
    function giftPrices() {
      return { 'heart': 15, 'bear': 15, 'gift': 25, 'rose': 25, 'cake': 50, 'bouquet': 50,
        'rocket': 50, 'champagne': 50, 'trophy': 100, 'ring': 100, 'diamond': 100 };
    }
    match /gifts/{id} {
      allow read: if signedIn();
      allow create: if canWrite() && request.resource.data.from == uid()
        && request.resource.data.to is string && request.resource.data.to != uid()
        && request.resource.data.type in giftPrices()
        && request.resource.data.get('count', 1) is int
        && request.resource.data.get('count', 1) >= 1 && request.resource.data.get('count', 1) <= 999
        && request.resource.data.price == giftPrices()[request.resource.data.type] * request.resource.data.get('count', 1)
        && getAfter(statusPath(uid())).data.spend == { 'k': 'gift', 'id': id };
      allow update: if signedIn() && resource.data.to == uid()
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['hidden']);
      // получатель может удалить подарок (при продаже или удалении данных)
      allow delete: if signedIn() && resource.data.to == uid();
    }

    // NFT-подарки: коллекции создают админы, экземпляры выпускаются по одному за LUNE
    match /nftCollections/{cid} {
      allow read: if signedIn();
      allow create, delete: if isAdmin();
      allow update: if isAdmin() || mintsOne(cid);
    }
    function mintsOne(cid) {
      let before = resource.data;
      let after = request.resource.data;
      return signedIn() && after.diff(before).affectedKeys().hasOnly(['minted'])
        && after.minted == before.minted + 1 && after.minted <= before.supply
        && before.get('active', true) == true
        && getAfter(/databases/$(database)/documents/nfts/$(cid + '_' + string(after.minted))).data.owner == uid();
    }
    match /nfts/{nid} {
      allow read: if signedIn();
      allow create: if canWrite() && request.resource.data.owner == uid()
        && nid == request.resource.data.cid + '_' + string(request.resource.data.num)
        && get(/databases/$(database)/documents/nftCollections/$(request.resource.data.cid)).data.minted == request.resource.data.num - 1
        && getAfter(/databases/$(database)/documents/nftCollections/$(request.resource.data.cid)).data.minted == request.resource.data.num
        && request.resource.data.backdrop in get(/databases/$(database)/documents/nftCollections/$(request.resource.data.cid)).data.backdrops
        && request.resource.data.salePrice == 0
        && getAfter(statusPath(uid())).data.spend == { 'k': 'mint', 'id': nid };
      allow update: if signedIn() && !isBanned()
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['owner', 'salePrice', 'prevOwner'])
        && request.resource.data.salePrice is int && request.resource.data.salePrice >= 0
        && (
          // владелец: выставить на продажу, снять с продажи или подарить
          (resource.data.owner == uid()
            && (request.resource.data.owner == uid() || request.resource.data.salePrice == 0))
          // покупатель: забирает выставленный NFT и платит продавцу
          || (resource.data.owner != uid() && resource.data.get('salePrice', 0) > 0
            && request.resource.data.owner == uid() && request.resource.data.salePrice == 0
            && getAfter(statusPath(uid())).data.spend == { 'k': 'buy', 'id': nid }
            && getAfter(statusPath(resource.data.owner)).data.sale == nid)
        );
      // владелец может удалить свой NFT при удалении аккаунта
      allow delete: if signedIn() && resource.data.owner == uid();
    }

    // Покупка дополнительного юзернейма: минус 100 LUNE и одно новое имя в списке;
    // само имя записывается в usernames в той же операции
    function buysUsername(userId) {
      let before = resource.data;
      let after = request.resource.data;
      let had = before.get('usernames', []);
      let name = after.usernames[had.size()];
      return signedIn() && uid() == userId && !isBanned()
        && after.diff(before).affectedKeys().hasOnly(['lune', 'usernames'])
        && before.get('lune', 0) >= 100
        && after.lune == before.get('lune', 0) - 100
        && after.usernames.size() == had.size() + 1
        && after.usernames.hasAll(had)
        && name is string
        && !exists(/databases/$(database)/documents/usernames/$(name))
        && getAfter(/databases/$(database)/documents/usernames/$(name)).data.uid == uid();
    }

    // Настройки приложения (TURN-сервер для звонков): читают все, меняют админы
    match /config/{key} {
      allow read: if signedIn();
      allow write: if isAdmin();
    }

    // Список админов ведёт владелец
    match /admins/{userId} {
      allow read: if signedIn();
      allow write: if isOwner();
    }

    // Занятые имена пользователей (уникальность @username).
    // Основное имя занимается вместе с созданием профиля, дополнительные — только покупкой за LUNE.
    match /usernames/{name} {
      allow read: if signedIn();
      allow create: if signedIn() && request.resource.data.uid == uid() && (
        (!exists(/databases/$(database)/documents/users/$(uid()))
          && getAfter(/databases/$(database)/documents/users/$(uid())).data.username == name)
        || (name in getAfter(statusPath(uid())).data.get('usernames', [])
          && !(name in st(uid()).get('usernames', [])))
      );
      allow delete: if signedIn() && resource.data.uid == uid();
    }

    // Файлы, разбитые на части до 1 МБ: до 20 МБ, с Plus до 50 МБ
    match /files/{fileId} {
      allow read: if signedIn();
      allow create: if signedIn() && !isBanned() && request.resource.data.owner == uid()
        && request.resource.data.size is int
        && request.resource.data.size <= (isPlus(uid()) ? 52428800 : 20971520);
      allow delete: if signedIn() && resource.data.owner == uid();

      match /chunks/{i} {
        allow read: if signedIn();
        allow create: if signedIn() && !isBanned()
          && get(/databases/$(database)/documents/files/$(fileId)).data.owner == uid()
          && request.resource.data.d is string && request.resource.data.d.size() <= 1000000;
        allow delete: if signedIn() && get(/databases/$(database)/documents/files/$(fileId)).data.owner == uid();
      }
    }

    // Лента: читать могут все вошедшие; лайки и счётчик комментариев меняет любой,
    // остальное — только автор
    match /posts/{postId} {
      allow read: if signedIn();
      allow create: if canWrite() && request.resource.data.author == uid()
        && request.resource.data.text is string && request.resource.data.text.size() <= 2000
        && (!('image' in request.resource.data) || request.resource.data.image.size() <= 950000);
      allow update: if signedIn() && !isBanned() && (resource.data.author == uid()
        || request.resource.data.diff(resource.data).affectedKeys().hasOnly(['likes', 'commentCount']));
      allow delete: if signedIn() && (resource.data.author == uid() || isAdmin());

      match /comments/{commentId} {
        allow read: if signedIn();
        allow create: if canWrite() && request.resource.data.author == uid()
          && request.resource.data.text is string && request.resource.data.text.size() <= 1000;
        // комментарий удаляет автор, автор поста или админ
        allow delete: if signedIn() && (resource.data.author == uid() || isAdmin()
          || get(/databases/$(database)/documents/posts/$(postId)).data.author == uid());
      }
    }

    // Уведомления: создаёт тот, кто действует; читает и отмечает прочитанными получатель
    match /activity/{id} {
      allow create: if signedIn() && !isBanned() && request.resource.data.from == uid() && request.resource.data.to != uid();
      allow update: if signedIn() && resource.data.to == uid();
      // свои уведомления (полученные и созданные) можно прочитать для выгрузки и удалить
      allow read, delete: if signedIn() && (resource.data.to == uid() || resource.data.from == uid());
    }

    // Чаты видят и меняют только участники; состав участников менять нельзя
    match /chats/{chatId} {
      allow get: if signedIn() && (resource == null || uid() in resource.data.members);
      allow list: if signedIn() && uid() in resource.data.members;
      allow create: if canWrite() && uid() in request.resource.data.members
        && request.resource.data.members.size() <= 200;
      // состав не меняется; можно только выйти самому (при удалении аккаунта)
      allow update: if signedIn() && uid() in resource.data.members
        && (request.resource.data.members == resource.data.members
          || request.resource.data.members == resource.data.members.removeAll([uid()]));

      match /messages/{messageId} {
        allow read: if signedIn() && isMember(chatId);
        allow create: if canWrite() && isMember(chatId)
          && request.resource.data.from == uid()
          && request.resource.data.text is string
          && request.resource.data.text.size() <= 4000
          && (!('image' in request.resource.data) || request.resource.data.image.size() <= 950000)
          && (!('audio' in request.resource.data) || request.resource.data.audio.size() <= 950000);
        // своё сообщение можно удалить (у всех)
        allow delete: if signedIn() && resource.data.from == uid();
      }
    }

    // Звонки: доступ только у звонящего и того, кому звонят
    match /calls/{callId} {
      allow get: if signedIn() && (resource == null || uid() == resource.data.from || uid() == resource.data.to);
      allow list, update, delete: if signedIn() && (uid() == resource.data.from || uid() == resource.data.to);
      allow create: if canWrite() && request.resource.data.from == uid();

      match /candidates/{candId} {
        allow read, create, delete: if signedIn() && (
          uid() == get(/databases/$(database)/documents/calls/$(callId)).data.from ||
          uid() == get(/databases/$(database)/documents/calls/$(callId)).data.to);
      }
    }
  }
}
